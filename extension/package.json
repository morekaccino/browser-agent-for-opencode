{
  "name": "opencode-browser-extension",
  "description": "Browser Agent for opencode — Chrome side panel for a local opencode V2 agent",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "prebuild": "node scripts/copy-plugin.mjs",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "prezip": "node scripts/copy-plugin.mjs",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/material-symbols-rounded": "^5.3.9",
    "@fontsource/roboto": "^5.3.0",
    "@opencode/client": "^2.0.32",
    "croner": "^10.0.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
